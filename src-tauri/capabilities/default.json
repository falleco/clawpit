{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window - OpenClaw management",
  "windows": ["main", "settings-window"],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:webview:allow-get-all-webviews",
    "core:webview:allow-webview-show",
    "core:webview:allow-set-webview-focus",
    "core:webview:allow-create-webview-window",
    "opener:default",

    "shell:allow-execute",
    "shell:allow-spawn",
    "shell:allow-stdin-write",
    "shell:allow-kill",

    "fs:allow-read",
    "fs:allow-write",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-copy-file",

    "store:allow-get",
    "store:allow-set",
    "store:allow-delete",
    "store:allow-keys",
    "store:allow-values",
    "store:allow-entries",
    "store:allow-length",
    "store:allow-load",
    "store:allow-save",
    "store:allow-clear",

    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm",

    "notification:default",
    "notification:allow-is-permission-granted",
    "notification:allow-request-permission",
    "notification:allow-notify",

    "process:allow-exit",
    "process:allow-restart",

    "liquid-glass:default"
  ]
}
