{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clawpit",
  "version": "0.1.0",
  "identifier": "com.clawpit.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Clawpit",
        "label": "main",
        "width": 1280,
        "height": 1000,
        "minWidth": 1024,
        "minHeight": 768,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": true,
        "visible": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": {
          "x": 24,
          "y": 32
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: https://asset.localhost data: https:; style-src 'self' 'unsafe-inline'; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$RESOURCE/**", "**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["resources/**/*"],
    "category": "Utility",
    "shortDescription": "OpenClaw Desktop Manager",
    "longDescription": "Clawpit makes it easy to set up, configure, and manage OpenClaw for non-technical users. Features guided setup, recipe management, and real-time monitoring.",
    "copyright": "Copyright (c) 2024 Clawpit Team",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {}
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
