        {
          "flag": "--message <text>",
          "description": "Message to send (required)"
        },
        { "flag": "--to <dest>", "description": "Target destination" },
        { "flag": "--agent <id>", "description": "Target agent ID" },
        { "flag": "--session-id <id>", "description": "Session ID" },
        {
          "flag": "--thinking <off|minimal|low|medium|high|xhigh>",
          "description": "Thinking level"
        },
        { "flag": "--verbose <on|full|off>", "description": "Verbose output" },
        { "flag": "--channel <name>", "description": "Channel type" },
        { "flag": "--local", "description": "Use local embedded agent" },
        { "flag": "--deliver", "description": "Deliver the reply" },
        { "flag": "--json", "description": "Output JSON" },
        { "flag": "--timeout <seconds>", "description": "Timeout in seconds" }
      ]
    },
