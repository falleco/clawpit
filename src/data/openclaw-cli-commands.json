            { "flag": "--force", "description": "Force reinstall" },
            { "flag": "--json", "description": "Output JSON" }
          ]
        },
        {
          "command": "uninstall",
          "description": "Uninstall Gateway service"
        },
        {
          "command": "start",
          "description": "Start Gateway service"
        },
        {
          "command": "stop",
          "description": "Stop Gateway service"
        },
        {
          "command": "restart",
          "description": "Restart Gateway service"
        }
