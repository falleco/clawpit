{
  "globalFlags": [
    {
      "flag": "--dev",
      "description": "Isolate state under ~/.openclaw-dev and shift default ports"
    },
    {
      "flag": "--profile <name>",
      "description": "Isolate state under ~/.openclaw-<name>"
    },
    { "flag": "--no-color", "description": "Disable ANSI colors" },
    {
      "flag": "--update",
      "description": "Shorthand for openclaw update (source installs only)"
    },
    { "flag": "-V, --version, -v", "description": "Print version and exit" }
  ],
  "commands": [
    {
      "command": "help",
      "description": "Show help information for commands",
      "usage": "help [command]"
    },
    {
      "command": "setup",
      "description": "Initialize config and workspace",
      "options": [
        { "flag": "--workspace <dir>", "description": "Agent workspace path" },
        { "flag": "--wizard", "description": "Run the onboarding wizard" },
        {
          "flag": "--non-interactive",
          "description": "Run wizard without prompts"
        },
        { "flag": "--mode <local|remote>", "description": "Wizard mode" },
        { "flag": "--remote-url <url>", "description": "Remote Gateway URL" },
        {
          "flag": "--remote-token <token>",
          "description": "Remote Gateway token"
        }
      ]
    },
    {
      "command": "onboard",
      "description": "Interactive wizard to set up gateway, workspace, and skills",
      "options": [
        { "flag": "--workspace <dir>", "description": "Agent workspace path" },
        {
          "flag": "--reset",
          "description": "Reset config + credentials + sessions + workspace before wizard"
        },
        { "flag": "--non-interactive", "description": "Run without prompts" },
        { "flag": "--mode <local|remote>", "description": "Wizard mode" },
        {
          "flag": "--flow <quickstart|advanced|manual>",
          "description": "Onboarding flow type"
        },
        { "flag": "--json", "description": "Output JSON" }
      ]
    },
    {
      "command": "configure",
      "description": "Interactive configuration wizard (models, channels, skills, gateway)"
    },
    {
      "command": "config",
      "description": "Non-interactive config helpers (get/set/unset)",
      "subcommands": [
        {
          "command": "get",
          "description": "Print a config value (dot/bracket path)",
          "usage": "config get <path>"
        },
        {
          "command": "set",
          "description": "Set a config value (JSON5 or raw string)",
          "usage": "config set <path> <value>",
          "options": [
            { "flag": "--json", "description": "Require JSON5 parsing" }
          ]
        },
        {
          "command": "unset",
          "description": "Remove a config value",
          "usage": "config unset <path>"
        }
      ]
    },
    {
      "command": "doctor",
      "description": "Health checks and quick fixes for config and gateway",
      "options": [
        {
          "flag": "--no-workspace-suggestions",
          "description": "Disable workspace memory hints"
        },
        { "flag": "--yes", "description": "Accept defaults without prompting" },
        {
          "flag": "--non-interactive",
          "description": "Skip prompts; apply safe migrations only"
        },
        {
          "flag": "--deep",
          "description": "Scan system services for extra gateway installs"
        }
      ]
    },
    {
      "command": "security",
      "description": "Security audit commands",
      "subcommands": [
        {
          "command": "audit",
          "description": "Audit config + local state for security issues",
          "options": [
            {
              "flag": "--deep",
              "description": "Best-effort live Gateway probe"
            },
            {
              "flag": "--fix",
              "description": "Tighten safe defaults and chmod state/config"
            }
          ]
        }
      ]
    },
    {
      "command": "reset",
      "description": "Reset local config/state (keeps CLI installed)",
      "options": [
        {
          "flag": "--scope <config|config+creds+sessions|full>",
          "description": "Reset scope"
        },
        { "flag": "--yes", "description": "Skip confirmation" },
        { "flag": "--non-interactive", "description": "Non-interactive mode" },
        { "flag": "--dry-run", "description": "Show what would be reset" }
      ]
    },
    {
      "command": "uninstall",
      "description": "Uninstall the gateway service and local data",
      "options": [
        { "flag": "--service", "description": "Uninstall service" },
        { "flag": "--state", "description": "Remove state" },
        { "flag": "--workspace", "description": "Remove workspace" },
        { "flag": "--app", "description": "Remove app" },
        { "flag": "--all", "description": "Remove everything" },
        { "flag": "--yes", "description": "Skip confirmation" },
        { "flag": "--non-interactive", "description": "Non-interactive mode" },
        { "flag": "--dry-run", "description": "Show what would be removed" }
      ]
    },
    {
      "command": "update",
      "description": "Update OpenClaw to the latest version"
    },
    {
      "command": "channels",
      "description": "Manage chat channel accounts (WhatsApp/Telegram/Discord/etc)",
      "subcommands": [
        {
          "command": "list",
          "description": "Show configured channels and auth profiles",
          "options": [
            {
              "flag": "--no-usage",
              "description": "Skip model provider usage snapshots"
            },
            { "flag": "--json", "description": "Output JSON" }
          ]
        },
        {
          "command": "status",
          "description": "Check gateway reachability and channel health",
          "options": [{ "flag": "--probe", "description": "Run extra checks" }]
        },
        {
          "command": "logs",
          "description": "Show recent channel logs from gateway",
          "options": [
            {
              "flag": "--channel <name|all>",
