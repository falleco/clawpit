            },
            { "flag": "--lines <n>", "description": "Number of lines" },
            { "flag": "--json", "description": "Output JSON" }
          ]
        },
        {
          "command": "add",
          "description": "Add a new channel account",
          "options": [
            {
              "flag": "--channel <name>",
              "description": "Channel type (whatsapp|telegram|discord|slack|etc)"
            },
            { "flag": "--account <id>", "description": "Account ID" },
            { "flag": "--name <label>", "description": "Display name" },
            { "flag": "--token <token>", "description": "Bot token" }
          ]
        },
        {
          "command": "remove",
          "description": "Remove a channel account",
          "options": [
            { "flag": "--channel <name>", "description": "Channel type" },
            { "flag": "--account <id>", "description": "Account ID" },
            { "flag": "--delete", "description": "Delete config entries" }
          ]
        },
        {
          "command": "login",
          "description": "Interactive channel login (WhatsApp Web)",
          "options": [
            { "flag": "--channel <name>", "description": "Channel type" },
            { "flag": "--account <id>", "description": "Account ID" },
            { "flag": "--verbose", "description": "Verbose output" }
          ]
        },
        {
          "command": "logout",
          "description": "Log out of a channel session",
          "options": [
            { "flag": "--channel <name>", "description": "Channel type" },
            { "flag": "--account <id>", "description": "Account ID" }
          ]
        },
        {
          "command": "capabilities",
          "description": "Fetch provider capability hints",
          "options": [
            { "flag": "--channel <name>", "description": "Channel type" },
            { "flag": "--target <id>", "description": "Target channel ID" }
          ]
        },
        {
          "command": "resolve",
          "description": "Resolve channel/user names to IDs",
          "options": [
            { "flag": "--channel <name>", "description": "Channel type" },
            { "flag": "--kind <user|group|auto>", "description": "Target type" }
          ]
        }
      ]
    },
    {
      "command": "skills",
      "description": "List and inspect available skills",
      "subcommands": [
        {
          "command": "list",
          "description": "List all skills",
          "options": [
            { "flag": "--eligible", "description": "Show only ready skills" },
            { "flag": "--json", "description": "Output JSON" },
            {
              "flag": "-v, --verbose",
              "description": "Include missing requirements"
            }
          ]
        },
        {
          "command": "info",
          "description": "Show details for one skill",
          "usage": "skills info <name>"
        },
        {
          "command": "check",
          "description": "Summary of ready vs missing requirements"
        }
      ]
    },
    {
      "command": "plugins",
      "description": "Manage extensions and their config",
      "subcommands": [
        {
          "command": "list",
          "description": "List installed plugins",
          "options": [{ "flag": "--json", "description": "Output JSON" }]
        },
        {
          "command": "info",
          "description": "Show details for a plugin",
          "usage": "plugins info <id>"
        },
        {
          "command": "install",
          "description": "Install a plugin",
          "usage": "plugins install <path|.tgz|npm-spec>"
        },
        {
          "command": "enable",
          "description": "Enable a plugin",
          "usage": "plugins enable <id>"
        },
        {
          "command": "disable",
          "description": "Disable a plugin",
          "usage": "plugins disable <id>"
        },
        {
          "command": "doctor",
          "description": "Report plugin load errors"
        }
      ]
    },
    {
      "command": "memory",
      "description": "Vector search over MEMORY.md files",
      "subcommands": [
        {
          "command": "status",
          "description": "Show index stats"
        },
        {
          "command": "index",
          "description": "Reindex memory files"
        },
        {
          "command": "search",
          "description": "Semantic search over memory",
          "usage": "memory search \"<query>\""
        }
      ]
    },
    {
      "command": "message",
      "description": "Unified outbound messaging and channel actions",
      "subcommands": [
        {
          "command": "send",
          "description": "Send a message",
          "options": [
            { "flag": "--target <dest>", "description": "Target recipient" },
