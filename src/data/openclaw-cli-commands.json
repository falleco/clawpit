        { "flag": "--timeout <ms>", "description": "Timeout in milliseconds" },
        {
          "flag": "--verbose",
          "description": "Verbose output with live probes"
        }
      ]
    },
    {
      "command": "sessions",
      "description": "List stored conversation sessions",
      "options": [
        { "flag": "--json", "description": "Output JSON" },
        { "flag": "--verbose", "description": "Verbose output" },
        { "flag": "--store <path>", "description": "Session store path" },
        {
          "flag": "--active <minutes>",
          "description": "Show active sessions within minutes"
        }
      ]
    },
    {
      "command": "gateway",
      "description": "Run and manage the WebSocket Gateway",
      "options": [
        { "flag": "--port <port>", "description": "WebSocket port" },
        {
          "flag": "--bind <loopback|lan|tailnet|auto|custom>",
          "description": "Listener bind mode"
        },
        { "flag": "--auth <token|password>", "description": "Auth mode" },
        { "flag": "--token <token>", "description": "Auth token" },
        { "flag": "--password <password>", "description": "Auth password" },
        {
          "flag": "--tailscale <off|serve|funnel>",
          "description": "Tailscale mode"
        },
        {
          "flag": "--allow-unconfigured",
          "description": "Allow start without config"
        },
        { "flag": "--dev", "description": "Dev mode" },
        { "flag": "--force", "description": "Kill existing listener" },
